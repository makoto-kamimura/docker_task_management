APP_NAME="Life Compass"
APP_ENV=local
# Laravel の暗号化キー（base64:... の 44 文字）。
# - ローカル: 空のままでよい。起動時に wait-for-db.sh が php artisan key:generate で自動生成する
#   （手動なら php artisan key:generate）
# - 本番: ここは空のままにし、コンテナの環境変数で渡す（docker_wordpress の platform/.env の TASK_APP_KEY）。
#   環境変数が .env より優先され、wait-for-db.sh も生成を飛ばす
#   生成: echo "base64:$(openssl rand -base64 32)"  または  php artisan key:generate --show
# 一度決めたら変えない（変えるとセッション・Cookie など暗号化済みのデータが読めなくなる）
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tokyo
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=life_compass
DB_USERNAME=app
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:3000

# ---- プッシュ通知の鍵（T-205）----------------------------------------
# 鍵ファイルは storage/app/private/ に置く（中身はすべて git 管理外）。
# パスはコンテナ内のパスで書く（app/api が /app にマウントされる）。
# 値が欠けている・鍵ファイルが読めないあいだは送信を飛ばす（ログに「not configured」と残るだけでエラーにはならない）。

# APNs（iPhone / Apple Watch）: Apple Developer の Certificates, Identifiers & Profiles → Keys で
# 「Apple Push Notifications service (APNs)」を有効にしたキーを作り、AuthKey_XXXXXXXXXX.p8 をダウンロード（再取得不可）
#   APNS_KEY_ID           キーの Key ID（10 文字。ファイル名の XXXXXXXXXX と同じ）
#   APNS_TEAM_ID          Team ID（Membership details の 10 文字）
#   APNS_BUNDLE_ID        iOS アプリの bundle id（app/mobile/app.json の ios.bundleIdentifier）
#   APNS_PRODUCTION       TestFlight / App Store 配布版は true、Xcode から入れた開発版は false
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.lifecompass.mobile
APNS_PRIVATE_KEY_PATH=/app/storage/app/private/apns/AuthKey_XXXXXXXXXX.p8
APNS_PRODUCTION=false

# FCM（Android）: Firebase コンソール → プロジェクトの設定 → サービス アカウント →
# 「新しい秘密鍵を生成」で JSON をダウンロード（private_key と client_email を含むもの）
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=/app/storage/app/private/fcm/service-account.json
